# ROP Connect — environment variables
# Copy to `.env` for local dev, and set these in Netlify (Site settings > Environment variables).
# NOTE: Only the anon/publishable key is used on the client. It is safe to expose because
# Supabase Row Level Security (RLS) enforces all access rules. NEVER put the service_role key here.

# Your Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Your Supabase anon / publishable key (Project Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=

# Optional: display name of the deployment shown in the UI footer
VITE_APP_ENV=production
